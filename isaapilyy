local function resolveImageUri(input)
    input = tostring(input or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if input == "" then return "" end

    if input:lower():sub(1, 4) == "http" then
        local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
        if httpRequest and writefile and getcustomasset then
            local success, response = pcall(function()
                return httpRequest({ Url = input, Method = "GET" })
            end)
            if success and response and (response.StatusCode == 200 or response.Status == 200) then
                local fileName = "crosshair_unified_cache.png"
                writefile(fileName, response.Body)
                return getcustomasset(fileName)
            end
        end
    end

    local cleanId = input:match("%d+")
    if cleanId and tonumber(cleanId) and tonumber(cleanId) > 0 then
        return "rbxthumb://type=Asset&id=" .. cleanId .. "&w=420&h=420"
    end
    return ""
end

