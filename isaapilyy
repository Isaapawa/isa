-- ACCIÓN TOGGLE SHIFTLOCK (SIN LAG / CON ROTACIÓN LIMPIA)
local shiftConnection = nil
local function setShiftLock(state)
    isLocked = state
    if isLocked then
        toggleShiftBtn.BackgroundColor3 = THEME.Green
        toggleShiftBtn.Text = "LOCK\nON"
        updateVisuals()

        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.CameraOffset = Vector3.new(1.7, 0.5, 0) end
        end

        shiftConnection = RunService.RenderStepped:Connect(function()
            local c = player.Character
            if not c then return end
            local root = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                hum.AutoRotate = false
                local look = camera.CFrame.LookVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude > 0.05 then
                    root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook.Unit)
                end
            end

            if settingsData.showTargetTracer and settingsData.enableAssist then
                local _, targetScreenPos = getBestHitTarget()
                if targetScreenPos then
                    targetMarker.Position = UDim2.new(0, targetScreenPos.X, 0, targetScreenPos.Y)
                    targetMarker.Visible = true
                else
                    targetMarker.Visible = false
                end
            else
                targetMarker.Visible = false
            end
        end)
    else
        toggleShiftBtn.BackgroundColor3 = THEME.Red
        toggleShiftBtn.Text = "LOCK\nOFF"
        crosshairDot.Visible = false
        fovCircle.Visible = false
        targetMarker.Visible = false
        dynamicImage.Visible = false

        if shiftConnection then
            shiftConnection:Disconnect()
            shiftConnection = nil
        end

        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.AutoRotate = true
                hum.CameraOffset = Vector3.zero
            end
        end
    end
end

toggleShiftBtn.MouseButton1Click:Connect(function()
    setShiftLock(not isLocked)
end)
