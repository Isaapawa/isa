    local resolvedImage = resolveImageUri(settingsData.customImageId)
    if resolvedImage ~= "" then
        crosshairDot.Visible = false
        dynamicImage.Image = resolvedImage
        dynamicImage.ImageColor3 = color
        local imgSize = math.clamp(settingsData.size * 3.2, 24, 90)
        dynamicImage.Size = UDim2.new(0, imgSize, 0, imgSize)
        dynamicImage.Visible = isLocked
    else
        dynamicImage.Visible = false
        crosshairDot.Visible = isLocked
    end
end

-- ==========================================================
-- BÚSQUEDA DE OBJETIVO (CACHEADA Y FILTRADA)
-- ==========================================================
local cachedTargetPart = nil
local cachedScreenPos = nil
local lastSearchTime = 0

local function getBestHitTarget()
    if not settingsData.enableAssist then return nil, nil end

    local now = os.clock()
    if (now - lastSearchTime) < 0.033 and cachedTargetPart and cachedTargetPart.Parent then
        local p, onScreen = camera:WorldToViewportPoint(cachedTargetPart.Position)
        if onScreen and p.Z > 0 then
            return cachedTargetPart, Vector2.new(p.X, p.Y)
        end
    end
    lastSearchTime = now

    local myChar = player.Character
    if not myChar then return nil, nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
    if not myRoot then return nil, nil end

    local myPos = myRoot.Position
    local center = camera.ViewportSize / 2
    local bestPart = nil
    local bestScreenPos = nil
    local bestDist = settingsData.assistPixelRadius

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso")
            if root then
                if (myPos - root.Position).Magnitude <= settingsData.clickRange then
                    local screenPoint, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen and screenPoint.Z > 0 then
                        local target2D = Vector2.new(screenPoint.X, screenPoint.Y)
                        local pixelDist = (center - target2D).Magnitude
                        if pixelDist < bestDist then
                            bestDist = pixelDist
                            bestPart = root
                            bestScreenPos = target2D
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        currentTargetModel = bestPart:FindFirstAncestorOfClass("Model")
    end

    cachedTargetPart = bestPart
    cachedScreenPos = bestScreenPos
    return bestPart, bestScreenPos
end

-- ==========================================================
-- MOTOR DE SPAM ADHERIDO AL HITBOX
-- ==========================================================
local isSpamRunning = false
local selectedKey = Enum.KeyCode.Q
local selectedDisplayName = "Q"
local currentThreadId = 0

local function stopBurstLoop()
    isSpamRunning = false
    currentThreadId = currentThreadId + 1
    if selectedKey then
        pcall(function() VIM:SendKeyEvent(false, selectedKey, false, game) end)
    end
end

local function startBurstLoop()
    stopBurstLoop()
    isSpamRunning = true
    currentThreadId = currentThreadId + 1
    local myThread = currentThreadId

    task.spawn(function()
        local keyHeld = false
        while isSpamRunning and (myThread == currentThreadId) do
            if selectedKey then
                keyHeld = not keyHeld
                VIM:SendKeyEvent(keyHeld, selectedKey, false, game)
            end

            local targetChar = currentTargetModel
            if targetChar then
                local bodyPart = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
                if bodyPart and camera then
                    local screenPos, onScreen = camera:WorldToViewportPoint(bodyPart.Position)
                    if onScreen and screenPos.Z > 0 then
                        VIM:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 0)
                        VIM:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 0)
                    end
                end
            end
            task.wait(0.024)
        end

        if selectedKey then
            pcall(function() VIM:SendKeyEvent(false, selectedKey, false, game) end)
        end
    end)
end

