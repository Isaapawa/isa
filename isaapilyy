local function createSlider(name, minVal, maxVal, currentVal, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 34)
    f.BackgroundTransparency = 1
    f.ZIndex = 102
    f.Parent = scroll

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 12)
    l.BackgroundTransparency = 1
    l.Text = name .. ": " .. tostring(math.floor(currentVal))
    l.TextColor3 = THEME.TextSecondary
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 9.5
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.ZIndex = 102
    l.Parent = f

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 10)
    track.Position = UDim2.new(0, 0, 0, 16)
    track.BackgroundColor3 = THEME.CardBg
    track.BorderSizePixel = 0
    track.ZIndex = 102
    track.Parent = f

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    local fill = Instance.new("Frame")
    local pct = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 103
    fill.Parent = track

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local activeFinger = nil
    local function updateVal(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        local val = minVal + ((maxVal - minVal) * rel)
        l.Text = name .. ": " .. tostring(math.floor(val))
        callback(val)
        saveSettings()
    end

    track.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeFinger then
            activeFinger = input
            updateVal(input.Position.X)
            local moveConn, endConn
            moveConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.Change then updateVal(input.Position.X) end
            end)
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    moveConn:Disconnect()
                    endConn:Disconnect()
                    activeFinger = nil
                end
            end)
        end
    end)
end

