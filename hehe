-- PROTECCIÓN TÁCTIL SIN BLOQUEAR SHIFTLOCK
-- ==========================================================
local isLocked = false

local function protectTouchControls()
    pcall(function()
        local pm = PlayerScripts:FindFirstChild("PlayerModule")
        if pm then
            local PlayerModule = require(pm)
            local controls = PlayerModule:GetControls()
            if controls then
                controls.OnLastInputTypeChanged = function(self, inputType)
                    if inputType == Enum.UserInputType.Keyboard or inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.MouseButton2 then
                        return
                    end
                    if inputType == Enum.UserInputType.Touch and self.touchControl then
                        self:SwitchToController(self.touchControl)
                    end
                end

                local originalSwitch = controls.SwitchToController
                controls.SwitchToController = function(self, newController)
                    if newController == self.keyboardController then
                        if self.touchControl then
                            return originalSwitch(self, self.touchControl)
                        end
                        return
                    end
                    return originalSwitch(self, newController)
                end

                if controls.touchControl and controls.activeController ~= controls.touchControl then
                    controls:SwitchToController(controls.touchControl)
                end
            end
        end
    end)
end

task.spawn(protectTouchControls)
player.CharacterAdded:Connect(function()
    task.wait(0.3)
    protectTouchControls()
end)

-- SISTEMA DRAGGABLE SEGURO
local function makeSafeDraggable(handle, targetFrame)
    local dragInput, dragStart, startPos = nil, nil, nil
    handle.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.MouseButton1) and not dragInput then
            dragInput = input
            dragStart = input.Position
            startPos = targetFrame.AbsolutePosition

            local conEnded
            conEnded = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragInput = nil
                    conEnded:Disconnect()
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.MouseMovement) then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(0, startPos.X + delta.X, 0, startPos.Y + delta.Y)
        end
    end)
end

