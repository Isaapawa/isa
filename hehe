-- BUCLE SHIFTLOCK (VINCULADO AL FRAME)
-- ==========================================================
local shiftConnection = nil

local function setShiftLock(state)
    isLocked = state
    if isLocked then
        toggleShiftBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        toggleShiftBtn.Text = "LOCK\nON"
        updateVisuals()

        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.CameraOffset = Vector3.new(1.7, 0.5, 0) end
        end

        shiftConnection = RunService.RenderStepped:Connect(function()
            local c = player.Character
            if not c then return end
            local root = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                hum.AutoRotate = false
                local look = camera.CFrame.LookVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude > 0.05 then
                    root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook.Unit)
                end
            end

            if settingsData.showTargetTracer and settingsData.enableAssist then
                local _, targetScreenPos = getBestHitTarget()
                if targetScreenPos then
                    targetMarker.Position = UDim2.new(0, targetScreenPos.X, 0, targetScreenPos.Y)
                    targetMarker.Visible = true
                else
                    targetMarker.Visible = false
                end
            else
                targetMarker.Visible = false
            end
        end)
    else
        toggleShiftBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        toggleShiftBtn.Text = "LOCK\nOFF"
        crosshairDot.Visible = false
        fovCircle.Visible = false
        targetMarker.Visible = false
        dynamicImage.Visible = false

        if shiftConnection then
            shiftConnection:Disconnect()
            shiftConnection = nil
        end

        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.AutoRotate = true
                hum.CameraOffset = Vector3.zero
            end
        end
    end
end

local draggingFinger, dragStartPos, btnStartPos, movedFar = nil, nil, nil, false
toggleShiftBtn.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not draggingFinger then
        draggingFinger = input
        dragStartPos = input.Position
        btnStartPos = toggleShiftBtn.Position
        movedFar = false

        local moveConn, endConn
        moveConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.Change then
                local delta = input.Position - dragStartPos
                if math.abs(delta.X) > 12 or math.abs(delta.Y) > 12 then
                    movedFar = true
                    toggleShiftBtn.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
                end
            end
        end)

        endConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                moveConn:Disconnect()
                endConn:Disconnect()
                draggingFinger = nil

                if not movedFar then
                    setShiftLock(not isLocked)
                end
            end
        end)
    end
end)
