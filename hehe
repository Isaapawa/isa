-- ==========================================================
-- DISPARO DIRECTO EN PANTALLA TÁCTIL (AL TOCAR LA MITAD DERECHA)
-- ==========================================================
local touchIdCounter = 100
local lastTapTime = 0

local function sendDirectTap()
    lastTapTime = tick()
    local center = camera.ViewportSize / 2
    local _, targetScreenPos = getBestHitTarget()
    local clickCoords = targetScreenPos or center

    touchIdCounter = (touchIdCounter % 500) + 1
    local currentId = touchIdCounter

    local char = player.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end

    pcall(function()
        VIM:SendTouchEvent(currentId, 0, clickCoords.X, clickCoords.Y)
        task.wait(0.015)
        VIM:SendTouchEvent(currentId, 2, clickCoords.X, clickCoords.Y)
    end)
end

local activeTaps = {}
local ignoredFingers = {}

UserInputService.InputBegan:Connect(function(input)
    if not isLocked then return end
    if input.UserInputType ~= Enum.UserInputType.Touch then return end

    local screenW = camera.ViewportSize.X
    local screenH = camera.ViewportSize.Y
    local posX, posY = input.Position.X, input.Position.Y

    if posX < (screenW * 0.45) then return end
    if posX > (screenW * 0.76) and posY > (screenH * 0.68) then return end

    local function isInside(gui)
        if not gui or not gui.Visible then return false end
        local pos, sz = gui.AbsolutePosition, gui.AbsoluteSize
        return posX >= pos.X and posX <= (pos.X + sz.X) and posY >= pos.Y and posY <= (pos.Y + sz.Y)
    end

    if isInside(toggleShiftBtn) or isInside(menuShiftBtn) or isInside(configPanel) or isInside(floatingBtn) or isInside(hubFrame) then
        ignoredFingers[input] = true
        return
    end

    activeTaps[input] = {
        startTime = tick(),
        startPos = input.Position,
        hasPanned = false
    }
end)

UserInputService.InputChanged:Connect(function(input)
    if not isLocked or input.UserInputType ~= Enum.UserInputType.Touch then return end
    local tap = activeTaps[input]
    if tap and not tap.hasPanned then
        if (input.Position - tap.startPos).Magnitude > 12 then
            tap.hasPanned = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if ignoredFingers[input] then ignoredFingers[input] = nil return end
    if not isLocked then return end
    local tap = activeTaps[input]
    if not tap then return end
    activeTaps[input] = nil

    local duration = tick() - tap.startTime
    local delta = (input.Position - tap.startPos).Magnitude

    if not tap.hasPanned and duration <= 0.20 and delta < 12 then
        if (tick() - lastTapTime) >= 0.08 then
            task.spawn(sendDirectTap)
        end
    end
end)

