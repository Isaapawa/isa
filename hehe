-- ==========================================================
-- BÚSQUEDA DE OBJETIVO CON CACHÉ
-- ==========================================================
local cachedTargetPart = nil
local cachedScreenPos = nil
local lastSearchTime = 0

local function getBestHitTarget()
    if not settingsData.enableAssist then return nil, nil end

    local now = os.clock()
    if (now - lastSearchTime) < 0.033 and cachedTargetPart and cachedTargetPart.Parent then
        local p, onScreen = camera:WorldToViewportPoint(cachedTargetPart.Position)
        if onScreen and p.Z > 0 then
            return cachedTargetPart, Vector2.new(p.X, p.Y)
        end
    end
    lastSearchTime = now

    local myChar = player.Character
    if not myChar then return nil, nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
    if not myRoot then return nil, nil end

    local myPos = myRoot.Position
    local center = camera.ViewportSize / 2
    local bestPart = nil
    local bestScreenPos = nil
    local bestDist = settingsData.assistPixelRadius

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso")
            if root then
                if (myPos - root.Position).Magnitude <= settingsData.clickRange then
                    local screenPoint, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen and screenPoint.Z > 0 then
                        local target2D = Vector2.new(screenPoint.X, screenPoint.Y)
                        local pixelDist = (center - target2D).Magnitude
                        if pixelDist < bestDist then
                            bestDist = pixelDist
                            bestPart = root
                            bestScreenPos = target2D
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        local foundModel = bestPart:FindFirstAncestorOfClass("Model")
        local foundPlayer = Players:GetPlayerFromCharacter(foundModel)
        if foundPlayer then
            getgenv().SyncTargetBridge.CurrentTarget = foundModel
            getgenv().SyncTargetBridge.TargetName = foundPlayer.Name
        end
    end

    cachedTargetPart = bestPart
    cachedScreenPos = bestScreenPos
    return bestPart, bestScreenPos
end

