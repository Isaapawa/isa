local lastEspTime = 0
RunService.RenderStepped:Connect(function()
    if not isEspActive then return end

    local now = os.clock()
    if (now - lastEspTime) < 0.08 then return end
    lastEspTime = now

    local myChar = player.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position or nil
    local currentVictim = getTargetCharacter()

    for targetPlayer, data in pairs(espStorage) do
        local tChar = targetPlayer.Character or data.char
        if tChar and tChar.Parent and data.hum and data.hum.Health > 0 then
            data.tag.Enabled = true
            local isVictim = (currentVictim ~= nil and tChar == currentVictim)

            if isVictim then
                data.highlight.Enabled = true
                data.nameLabel.TextColor3 = THEME.Accent
                data.nameLabel.Text = "★ " .. targetPlayer.DisplayName .. " ★"
                data.infoLabel.TextColor3 = THEME.Red
                data.hpFill.BackgroundColor3 = THEME.Red
            else
                data.highlight.Enabled = false
                data.nameLabel.TextColor3 = THEME.TextPrimary
                data.nameLabel.Text = targetPlayer.DisplayName
                data.infoLabel.TextColor3 = THEME.Green
                data.hpFill.BackgroundColor3 = THEME.Green
            end

            local maxHp = math.floor(data.hum.MaxHealth)
            local hpPercent = math.clamp(data.hum.Health / math.max(1, maxHp), 0, 1)
            data.hpFill.Size = UDim2.new(hpPercent, 0, 1, 0)

            local tRoot = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso")
            local dist = 0
            if myPos and tRoot then dist = math.floor((myPos - tRoot.Position).Magnitude) end
            data.infoLabel.Text = string.format("%d HP • %dm", math.floor(data.hum.Health), dist)
        else
            if data.highlight then data.highlight.Enabled = false end
            if data.tag then data.tag.Enabled = false end
        end
    end
end)

